@using data_storage_website_ap5pw.Domain.Entities
@model IList<File>

@{
    ViewData["Title"] = "File Administration";
}
<h1>@ViewData["Title"]</h1>

<a asp-action="Create">Create File</a>

@{
    if (Model != null && Model.Count > 0)
    {
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">@nameof(File.Id)</th>
                    <th scope="col">@nameof(File.FileName)</th>
                    <th scope="col">@nameof(File.Topic)</th>
                    <th scope="col">@nameof(File.Text)</th>
                    <th scope="col">@nameof(File.AuthorId)</th>
                    <th scope="col">Edit</th>
                    <th scope="col">Delete</th>
                </tr>
            </thead>
            <tbody>

                @for (int i = 0; i < Model.Count; ++i)
                {
                    File file = Model[i];
                    <tr>
                        <th scope="row">@file.Id</th>
                        <td>@file.FileName</td>
                        <td>@file.Topic</td>
                        <td>@file.Text</td>
                        <td>@file.AuthorId</td>
                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@file.Id"
                               class="btn btn-secondary">
                                Edit
                            </a>
                        </td>
                        <td>
                            <form asp-action="Delete" asp-route-id="@file.Id" method="post" onclick="return confirmDelete();">
                                <button type="submit" class="btn btn-primary">Delete</button>
                            </form>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    }
    else
    {
        <p>File table is empty!</p>
    }
}

@section Scripts
{
    <script src="~/js/dialogs.js"></script>
}