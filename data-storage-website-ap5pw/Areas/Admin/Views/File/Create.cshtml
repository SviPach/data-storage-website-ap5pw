@model File

@{
    ViewData["Title"] = "File - Create";
}
<h1>@ViewData["Title"]</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label" asp-for="FileName"></label>
        <input class="form-control" asp-for="FileName">
        <span asp-validation-for="FileName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Topic"></label>
        <input class="form-control" asp-for="Topic">
        <span asp-validation-for="Topic" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Text"></label>
        <textarea class="form-control" asp-for="Text" rows="8"></textarea>
        <span asp-validation-for="Text" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Submit</button>
</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}