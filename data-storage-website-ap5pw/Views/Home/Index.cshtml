@model IndexViewModel

@{
    ViewData["Title"] = "Data Storage - Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Data Storage</h1>
</div>

@{
    if (Model != null && Model.Carousels != null && Model.Carousels.Count > 0)
    {
        <div id="carouselExampleControls" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">

                @{
                    string active = "active";
                    IList<Carousel> carousels = Model.Carousels;

                    for (int i = 0; i < carousels.Count; ++i)
                    {
                        <div class="carousel-item @active">
                            <img src="@carousels[i].ImageSrc" class="d-block w-100" alt="@carousels[i].ImageAlt">
                        </div>

                        active = String.Empty;
                    }
                }

            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    }
}

@{
    if (Model != null && Model.Files != null && Model.Files.Count > 0)
    {
        <section class="py-5">
            <div class="container px-4 px-lg-5 mt-5">
                <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-start">

                    @foreach (var file in Model.Files)
                    {
                        <div class="col mb-5">
                            <div class="card h-100">
                                <!-- File preview-->
                                <img class="card-img-top"/>
                                <!-- Product details-->
                                <div class="card-body p-4">
                                    <div class="text-center">
                                        <!-- File name-->
                                        <h5 class="fw-bolder">@file.FileName</h5>
                                        <!-- File topic-->
                                        @file.Topic
                                    </div>
                                </div>
                                <!-- File actions-->
                                <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                                    <div class="text-center"><a class="btn btn-outline-dark mt-auto" href="#">View</a></div>
                                    <div class="text-center"><a class="btn btn-outline-dark mt-auto" href="#">Download</a></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
}